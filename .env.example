# Aarogya Emergency QR Scribe - Environment Variables
# Copy this file to .env and configure as needed.
# No variables are required for demo mode.

# Supabase Configuration (optional - enables database persistence)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI API Configuration (optional - enables real LLM integration)
# When not configured, uses deterministic demo parser
# VITE_AI_API_URL=https://your-ai-endpoint.com/generate
# VITE_AI_API_KEY=your-api-key-here

# Base URL for QR codes (optional - defaults to window.location.origin)
# Set this when deploying to a custom domain
# VITE_BASE_URL=https://your-deployed-domain.com
